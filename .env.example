# Wzór zmiennych środowiskowych. Prawdziwe wartości wpisujesz TYLKO w Vercel
# (Project -> Settings -> Environment Variables), nigdy w tym pliku.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcjonalnie: e-maile z dostępem do Claude, rozdzielone przecinkami
ALLOWED_EMAILS=
# Kto widzi zakładkę Koszty (opcjonalne; bez tego: pierwszy adres z ALLOWED_EMAILS)
OWNER_EMAIL=
# Opcjonalnie: łączny miesięczny limit wydatków całej aplikacji w USD
MONTHLY_CAP_USD=5
# Opcjonalnie: lektor z chmury (Google Cloud Text-to-Speech, głosy Chirp 3 HD)
GOOGLE_TTS_KEY=
# Kopie zapasowe (ekran O mnie → Kopie zapasowe). Kopie robi PRYWATNE repozytorium, np. login/staysi-kopie:
# GITHUB_REPO to jego nazwa, GITHUB_TOKEN ma dostęp tylko do niego. To samo BACKUP_PASSWORD musi być też w sekretach
# tamtego repozytorium (Settings → Secrets and variables → Actions, razem z SUPABASE_URL i SUPABASE_SERVICE_ROLE_KEY).
GITHUB_TOKEN=
GITHUB_REPO=
BACKUP_PASSWORD=
